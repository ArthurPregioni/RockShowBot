# Private configuration; installer generates APP_PASSWORD on the device.
APP_USER=admin
APP_PASSWORD=
HOST=127.0.0.1
PORT=8765
SCAN_INTERVAL_HOURS=12
EVENT_RETENTION_DAYS=30
WAKE_LOCK=true
ADMIN_CONTACT=

# Python backend only. These do not configure the hosted Sites installation.
TICKETMASTER_API_KEY=
PREDICTHQ_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="RockShowBot <rockshowbot@example.com>"
SMTP_STARTTLS=true

# Optional official artist imports; browser-extension import belongs to Sites.
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_DEVELOPER_TOKEN_FILE=
APPLE_MUSIC_ORIGIN=
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=

# DATABASE_PATH is managed outside the checkout by rockshowbot run.
