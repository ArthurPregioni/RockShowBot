# Prefer setup.mjs: it generates a private hash and initial login credentials.
APP_USER=admin
APP_PASSWORD_HASH=
ADMIN_NAME=Administrador
HOST=127.0.0.1
PORT=8765
ROCKSHOWBOT_SITE_ORIGIN=http://127.0.0.1:8765
ROCKSHOWBOT_SCHEDULER=false
ROCKSHOWBOT_DELIVERY_ENABLED=true
# Set to a private persistent path; setup chooses ~/.local/share/rockshowbot/web.db.
DATABASE_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Optional official provider logins; extension import does not require these.
APPLE_MUSIC_DEVELOPER_TOKEN=
SPOTIFY_CLIENT_ID=
TICKETMASTER_API_KEY=
PREDICTHQ_API_KEY=
