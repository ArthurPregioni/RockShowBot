{
  "name": "rockshowbot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node tooling/sites/install-ci.mjs",
    "dev": "node tooling/sites/run-framework.mjs dev",
    "build": "node scripts/package-extension.mjs && node tooling/sites/run-framework.mjs build",
    "start": "node --import ./tooling/sites/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "extension:build": "node scripts/package-extension.mjs",
    "test:web": "node --experimental-strip-types --test tests/web/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests/selfhosted -v",
    "check:types": "tsc --noEmit",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "sources:check": "node --experimental-strip-types scripts/check-radar-sources.mjs",
    "test:delivery-flow": "node tests/integration/alert-deliveries.mjs",
    "test": "npm run test:web && npm run test:python && node --test tests/selfhosted/apple_music_browser.test.cjs",
    "check:repo": "python3 scripts/check-public-repo.py",
    "db:migrate:local": "node --import ./tooling/sites/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local --config dist/server/wrangler.json --persist-to .wrangler/state",
    "start:python": "python3 -m selfhosted.rockshowbot"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261030.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "json-rpc-2.0": "1.7.1",
    "playwright": "1.64.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.4.0",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "description": "Radar open source de shows futuros e antecipa\u00e7\u00f5es, com importa\u00e7\u00e3o de artistas e alertas por e-mail.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArthurPregioni/RockShowBot.git"
  }
}
