# Ticketmaster Discovery API key (optional; get one at developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# SMTP settings. Without these, scans still save events, but do not email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=RockShowBot <rockshowbot@example.com>
SMTP_STARTTLS=true

# App settings
DATABASE_PATH=rockshowbot.db
PORT=8000
SCAN_INTERVAL_HOURS=12
