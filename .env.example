# Admin login (required). Choose a strong password before exposing the app publicly.
APP_USER=admin
APP_PASSWORD=change-this-to-a-long-random-password
ADMIN_CONTACT=

# Event sources. Both API keys are optional; manual community tips always work.
# Ticketmaster Discovery: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
# PredictHQ: https://www.predicthq.com/
PREDICTHQ_API_KEY=

# SMTP settings. Without these, scans still save events, but do not email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="RockShowBot <rockshowbot@example.com>"
SMTP_STARTTLS=true

# App settings (Render sets PORT; /var/data is its persistent disk mount)
DATABASE_PATH=rockshowbot.db
PORT=8000
SCAN_INTERVAL_HOURS=12
EVENT_RETENTION_DAYS=30
